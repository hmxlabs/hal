    {
      "name": "three_branches_three_deep_midnode_delete_then_refill",
      "steps": [
        {
          "op": "write",
          "node": "root1",
          "key": "test:r3b3d:delete-refill:001",
          "value": "delete-refill-value-001"
        },
        {
          "op": "read",
          "node": "branch2a",
          "key": "test:r3b3d:delete-refill:001",
          "expected_value": "delete-refill-value-001",
          "require_state_change": true
        },
        {
          "op": "read",
          "node": "branch2b",
          "key": "test:r3b3d:delete-refill:001",
          "expected_value": "delete-refill-value-001",
          "require_state_change": true
        },
        {
          "op": "read",
          "node": "branch2c",
          "key": "test:r3b3d:delete-refill:001",
          "expected_value": "delete-refill-value-001",
          "require_state_change": true
        },
        {
          "op": "read",
          "node": "branch1c",
          "key": "test:r3b3d:delete-refill:001",
          "expected_value": "delete-refill-value-001",
          "require_state_change": true
        },
        {
          "op": "delete",
          "node": "branch2b",
          "key": "test:r3b3d:delete-refill:001"
        },
        {
          "op": "sleep",
          "seconds": 1
        },
        {
          "op": "read",
          "node": "branch1c",
          "key": "test:r3b3d:delete-refill:001",
          "expected_value": "delete-refill-value-001"
        },
